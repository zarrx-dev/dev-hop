{
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single"
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true
        }
    },
    "files": {
        "includes": ["extension/**", "tests/**", "!extension/icons/**"]
    },
    "overrides": [
        {
            "includes": ["extension/stylesheet.css"],
            "linter": {
                "rules": {
                    "correctness": {
                        "noUnknownProperty": "off",
                        "noUnknownTypeSelector": "off"
                    }
                }
            }
        }
    ]
}
